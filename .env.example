# TYPE X Core — environment variables (server-side only; never expose client-side)
# Copy to .env and fill in. All keys are read lazily at call time.

# Postgres connection string (Neon recommended). If unset → DEMO MODE (in-memory store).
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/typex?sslmode=require"

# respond.io API key (Bearer token) for the WhatsApp adapter.
RESPONDIO_API_KEY=""
# Optional: respond.io WhatsApp channel id (else inferred at send time).
RESPONDIO_WHATSAPP_CHANNEL_ID=""

# Cloud AI providers (optional — LocalProvider works without any key).
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Set to 1 to skip LocalProvider's simulated "thinking" delays (tests / scripts).
TYPEX_AI_FAST=""
